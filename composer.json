{
    "name": "laborb/statamic-notifications-channel",
    "description": "Get notifications on Statamic events",
    "type": "statamic-addon",
    "keywords": [
        "statamic-addon",
        "notifications",
        "events"
    ],
    "homepage": "https://laborb.de",
    "authors": [
        {
            "name": "Jannis Forsth\u00f6vel",
            "email": "jf@laborb.de",
            "homepage": "https://laborb.de",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Laborb\\StatamicNotificationsChannel\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Notifications",
            "description": "Statamic Notifications addon"
        },
        "laravel": {
            "providers": [
                "Laborb\\StatamicNotificationsChannel\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel-notification-channels/webhook": "^2.4",
        "laravel-notification-channels/microsoft-teams": "^1.1",
        "laravel/slack-notification-channel": "^3.2",
        "statamic/cms": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
